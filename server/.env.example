# Getva Hotel Server Environment Variables
PORT=5000
NODE_ENV=development

# MongoDB Connection (uses in-memory fallback if not reachable in local dev)
MONGODB_URI=mongodb://127.0.0.1:27017/getva_hotel

# JWT Authentication Secret (Use a strong 64+ char random string in production)
JWT_SECRET=getva_hotel_debre_birhan_secure_jwt_secret_key_2026_xyz!
JWT_EXPIRES_IN=7d

# CORS Allowed Origin
CLIENT_ORIGIN=http://localhost:5173

# Admin Bootstrap Credentials (Used during initial DB seed)
ADMIN_BOOTSTRAP_EMAIL=admin@getvahotel.com
ADMIN_BOOTSTRAP_PASSWORD=Admin@Getva2026
ADMIN_BOOTSTRAP_NAME=General Manager
